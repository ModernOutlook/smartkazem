<main class="page child-page fr-page fr-hub-page" lang="fa" dir="rtl" aria-labelledby="fr-title">
 <header class="fr-head">
  <div><p class="fr-eyebrow">FIVE REALMS · GAMES</p><h1 id="fr-title" data-i18n="pages.fiveRealms.title">بازی ۵ قلمرو</h1><p data-i18n="pages.gameHub.subtitle">پنج بازی، پنج قلمرو</p></div>
  <button id="five-realms-close" class="fr-close" type="button" data-i18n="labels.back" data-i18n-aria="labels.back">بازگشت</button>
 </header>
 <section class="fr-hub-grid" aria-label="Five Realms games">
  <button class="fr-game-tile fr-game-talash" type="button" data-talash-link><span class="fr-game-number">۱</span><strong data-i18n="pages.gameHub.talash">تلاش</strong><span data-i18n="pages.gameHub.structure">ساختار تالار</span></button>
  <button class="fr-game-tile" type="button" disabled aria-disabled="true"><span class="fr-game-number">۲</span><strong data-i18n="pages.gameHub.gold">طلا</strong><span data-i18n="pages.gameHub.continuity">تداوم عالم</span><small data-i18n="pages.gameHub.comingSoon">در دست ساخت</small></button>
  <button class="fr-game-tile" type="button" disabled aria-disabled="true"><span class="fr-game-number">۳</span><strong data-i18n="pages.gameHub.experience">تجربه</strong><span data-i18n="pages.gameHub.experienceRealm">قلمرو تجربه</span><small data-i18n="pages.gameHub.comingSoon">در دست ساخت</small></button>
  <button class="fr-game-tile" type="button" disabled aria-disabled="true"><span class="fr-game-number">۴</span><strong data-i18n="pages.gameHub.simulation">شبیه‌سازی</strong><span data-i18n="pages.gameHub.reference">مرجع تقلید</span><small data-i18n="pages.gameHub.comingSoon">در دست ساخت</small></button>
  <button class="fr-game-tile fr-game-tadbir" type="button" data-tadbir-link><span class="fr-game-number">۵</span><strong data-i18n="pages.gameHub.tadbir">تدبیر</strong><span data-i18n="pages.gameHub.share">اقتصاد سهم</span></button>
 </section>
</main>