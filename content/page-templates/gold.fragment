<main class="page child-page fr-page fr-placeholder-page fr-gold-page" lang="fa" dir="rtl" aria-labelledby="gold-title">
 <header class="fr-head">
  <div><p class="fr-eyebrow">CONTINUITY OF THE UNIVERSE · G</p><h1 id="gold-title" data-i18n="pages.gameHub.gold">طلا</h1><p data-i18n="pages.gameHub.continuity">تداوم عالم</p></div>
  <button id="gold-close" class="fr-close" type="button" data-i18n="labels.back" data-i18n-aria="labels.back">بازگشت</button>
 </header>
 <section class="gold-jewel-layout" aria-labelledby="gold-jewel-heading">
  <div class="gold-jewel-stage">
   <p class="gold-kicker">GOLD · CHARGE EVOLUTION</p>
   <h2 id="gold-jewel-heading">جواهر زرین</h2>
   <div class="gold-gem" data-gold-gem data-stage="0" role="img" aria-label="جواهر زرین؛ شارژ خالی">
    <svg viewBox="0 0 320 360" aria-hidden="true" focusable="false">
     <defs>
      <linearGradient id="gold-metal" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff4bb"/><stop offset=".22" stop-color="#e8b94f"/><stop offset=".48" stop-color="#fffbe0"/><stop offset=".72" stop-color="#a96a16"/><stop offset="1" stop-color="#ffe7a0"/></linearGradient>
      <linearGradient id="gold-fill" x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#8b4d05"/><stop offset=".45" stop-color="#e3a82e"/><stop offset="1" stop-color="#fffbd9"/></linearGradient>
      <linearGradient id="gold-glass" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".88"/><stop offset=".3" stop-color="#fff3bd" stop-opacity=".15"/><stop offset=".68" stop-color="#ffdc70" stop-opacity=".46"/><stop offset="1" stop-color="#fff" stop-opacity=".72"/></linearGradient>
      <clipPath id="gold-gem-clip"><path d="M160 24 244 76 292 157 256 265 160 330 64 265 28 157 76 76Z"/></clipPath>
      <filter id="gold-glow" x="-70%" y="-70%" width="240%" height="240%"><feGaussianBlur stdDeviation="8" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
     </defs>
     <circle class="gold-aura" cx="160" cy="180" r="130"/>
     <g clip-path="url(#gold-gem-clip)">
      <rect x="20" y="20" width="280" height="320" fill="#39230b"/>
      <rect class="gold-liquid" data-gold-liquid x="20" y="330" width="280" height="0" fill="url(#gold-fill)"/>
      <path class="gold-facet gold-facet-a" d="M160 24 160 330 64 265 28 157 76 76Z" fill="#fff1a8" fill-opacity=".08"/>
      <path class="gold-facet" d="M160 24 244 76 292 157 160 180Z" fill="#fff" fill-opacity=".15"/>
      <path class="gold-facet" d="M160 180 292 157 256 265 160 330Z" fill="#f9c84d" fill-opacity=".15"/>
      <path class="gold-facet" d="M160 180 64 265 160 330Z" fill="#fff5bf" fill-opacity=".14"/>
      <path class="gold-facet" d="M76 76 160 180 28 157Z" fill="#fff" fill-opacity=".12"/>
      <path class="gold-shine" d="M82 86 145 45 112 149 75 182Z" fill="#fff" fill-opacity=".48"/>
      <path class="gold-shine" d="M182 47 231 82 265 146 225 121Z" fill="#fff" fill-opacity=".25"/>
      <g class="gold-inner-facets" fill="none" stroke="#fff5c2" stroke-width="1.5" stroke-opacity=".58">
       <path d="M160 24 160 180 244 76M160 180 76 76M160 180 28 157M160 180 64 265M160 180 256 265M160 180 292 157M64 265 256 265M76 76 244 76"/>
       <path d="M112 149 160 180 225 121M112 149 64 265M225 121 256 265"/>
      </g>
     </g>
     <path class="gold-outline" d="M160 24 244 76 292 157 256 265 160 330 64 265 28 157 76 76Z" fill="url(#gold-glass)" stroke="url(#gold-metal)" stroke-width="5" stroke-linejoin="round"/>
     <path class="gold-outline-inner" d="M160 40 231 84 276 157 244 253 160 311 76 253 44 157 89 84Z" fill="none" stroke="#fff1a4" stroke-opacity=".6" stroke-width="1.5"/>
     <g class="gold-sparks" fill="#fffbe4"><path d="M246 46 251 61 266 66 251 71 246 86 241 71 226 66 241 61Z"/><path d="M59 203 62 212 71 215 62 218 59 227 56 218 47 215 56 212Z"/><circle cx="226" cy="237" r="3"/><circle cx="91" cy="105" r="2.5"/></g>
    </svg>
   </div>
   <p class="gold-charge-readout"><strong data-gold-charge>0</strong><span> / 3600 unit</span></p>
   <div class="gold-progress-track" role="progressbar" aria-label="میزان شارژ جواهر" aria-valuemin="0" aria-valuemax="3600" aria-valuenow="0" data-gold-progress><span data-gold-progress-fill></span></div>
   <p class="gold-stage-caption" data-gold-stage-label>مرحلهٔ ۰ از ۷۲ · آغاز تکامل</p>
  </div>
  <div class="gold-charge-panel">
   <h3>توالی تکامل</h3>
   <p>با افزایش شارژ، برش‌های هندسی منظم‌تر، اندازهٔ جزئیات متنوع‌تر، شفافیت و درخشش جواهر به‌تدریج افزایش می‌یابد. پایان توالی برابر با شارژ کامل است؛ شارژ صفر دقیقاً به مرحلهٔ آغاز برمی‌گردد.</p>
   <label for="gold-charge-input">تنظیم شارژ (۰ تا ۳۶۰۰)</label>
   <input id="gold-charge-input" type="number" min="0" max="3600" step="1" value="0" inputmode="numeric">
   <div class="gold-controls"><button type="button" data-gold-set="0">خالی</button><button type="button" data-gold-set="1800">نیمه</button><button type="button" data-gold-set="3600">کامل</button></div>
   <p class="gold-sync-status" data-gold-sync-status aria-live="polite">مکانیزم شارژ آماده است.</p>
  </div>
 </section>
</main>
