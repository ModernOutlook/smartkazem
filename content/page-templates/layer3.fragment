<div class="chapter-row" id="chapters"></div>
</nav>
<nav class="parts" id="parts" aria-label="بخش‌های فصل" data-i18n-aria="labels.chapterSections"></nav>
<article class="reader" id="reader" tabindex="-1" aria-live="polite" aria-atomic="false" aria-labelledby="reader-title"></article>
</main>


