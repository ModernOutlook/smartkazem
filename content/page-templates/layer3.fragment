
<main class="page child-page" id="page">

<header class="head">
<div class="head-main"><div class="head-title" id="head-title">پژواک لایه سوم</div><div class="head-sub" id="head-sub">پروتکل هماهنگی</div></div>
<button class="close" id="close" type="button" aria-label="بازگشت" data-i18n-aria="labels.back">✕</button>
</header>
<nav class="toc" aria-label="فهرست فصل‌ها" aria-labelledby="toc-label" data-i18n-aria="labels.chapterList">
