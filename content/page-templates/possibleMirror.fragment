
<section class="possible-mirror-page child-page" aria-labelledby="possible-mirror-title">
  <div class="possible-mirror-scene" aria-hidden="true">
    <div class="possible-mirror-river"></div>
    <div class="possible-mirror-ring r1"></div><div class="possible-mirror-ring r2"></div>
    <div class="possible-mirror-ring r3"></div><div class="possible-mirror-ring r4"></div>
    <div class="possible-mirror-island i1"></div><div class="possible-mirror-island i2"></div><div class="possible-mirror-island i3"></div>
    <div class="possible-mirror-reflection"></div>
  </div>
  
  <header class="possible-mirror-head">
    <div class="possible-mirror-title">
      <strong id="possible-mirror-title">آینه‌ی ممکن‌ها</strong>
      <span id="possible-mirror-subtitle">رمانی در باب اراده، احتمال و بازتاب</span>
    </div>
    <button class="possible-mirror-close" id="possible-mirror-close" type="button" data-i18n-aria="pages.possibleMirror.close" aria-label="بازگشت">✕</button>
  </header>
  <div class="possible-mirror-shell">
    <nav class="possible-mirror-tabs" id="possible-mirror-tabs" aria-label="فهرست بخش‌ها" data-i18n-aria="labels.sectionList"></nav>
    <article class="possible-mirror-body" id="possible-mirror-body" tabindex="-1" aria-live="polite" aria-atomic="false"></article>
  </div>
</section>



