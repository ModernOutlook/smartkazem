
<main class="treatise-page child-page" id="main-content">
  <div class="treatise-shell">
    <header class="treatise-header">
      <div class="treatise-brand">MODERN OUTLOOK <span aria-hidden="true">/</span> S</div>
      <div class="treatise-actions">
        <button class="treatise-back" id="close" type="button" data-i18n="labels.back">بازگشت</button>
      </div>
    </header>
    <nav class="treatise-tabs" id="tabs" aria-label="فهرست رساله" data-i18n-aria="pages.treatise.tabsLabel">
      <button class="treatise-tab book-tab active" data-i18n="pages.treatise.tabs.0" data-target="preface" type="button">پیش‌گفتار</button>
      <button class="treatise-tab book-tab" data-i18n="pages.treatise.tabs.1" data-target="r1" type="button">ساختار تالار</button>
      <button class="treatise-tab book-tab" data-i18n="pages.treatise.tabs.2" data-target="r2" type="button">تداوم عالم</button>
      <button class="treatise-tab book-tab" data-i18n="pages.treatise.tabs.3" data-target="r3" type="button">تجربه</button>
      <button class="treatise-tab book-tab" data-i18n="pages.treatise.tabs.4" data-target="r4" type="button">اقتدار شبیه‌سازی</button>
      <button class="treatise-tab book-tab" data-i18n="pages.treatise.tabs.5" data-target="r5" type="button">اقتصاد سهم‌ها</button>
      <button class="treatise-tab book-tab" data-i18n="pages.treatise.tabs.6" data-target="postscript" type="button">پس‌گفتار</button>
    </nav>
    <article class="treatise-article" id="body" aria-label="رساله فلسفی نگرش نوین" data-i18n-aria="labels.treatise">
      <div class="treatise-mark" aria-hidden="true">S</div>
      <div class="treatise-content" id="treatise-content"></div>
    </article>
    <footer class="treatise-footer" aria-hidden="true">ساختار تالار · STRUCTURE OF THE HALL</footer>
  </div>
</main>
