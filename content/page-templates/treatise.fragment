
<main class="treatise-page child-page" id="main-content">
  <div class="treatise-shell">
    <header class="treatise-header">
      <div class="treatise-brand">MODERN OUTLOOK <span aria-hidden="true">/</span> S</div>
      <div class="treatise-actions">
        <button class="treatise-back" id="close" type="button" data-i18n="labels.back">بازگشت</button>
      </div>
    </header>
    <nav class="treatise-tabs" id="tabs" aria-label="فهرست رساله" data-i18n-aria="pages.treatise.tabsLabel">
      <button class="treatise-tab book-tab active" data-target="preface" type="button"><span class="tab-number"></span><span class="tab-separator" aria-hidden="true"> · </span><span class="tab-label" data-i18n="pages.treatise.tabs.0">پیش‌گفتار</span></button>
      <button class="treatise-tab book-tab" data-target="r1" type="button"><span class="tab-number" aria-hidden="true"></span><span class="tab-label" data-i18n="pages.treatise.tabs.1">ساختار تالار</span></button>
      <button class="treatise-tab book-tab" data-target="r2" type="button"><span class="tab-number" aria-hidden="true"></span><span class="tab-label" data-i18n="pages.treatise.tabs.2">تداوم عالم</span></button>
      <button class="treatise-tab book-tab" data-target="r3" type="button"><span class="tab-number" aria-hidden="true"></span><span class="tab-label" data-i18n="pages.treatise.tabs.3">تجربه</span></button>
      <button class="treatise-tab book-tab" data-target="r4" type="button"><span class="tab-number" aria-hidden="true"></span><span class="tab-label" data-i18n="pages.treatise.tabs.4">اقتدار شبیه‌سازی</span></button>
      <button class="treatise-tab book-tab" data-target="r5" type="button"><span class="tab-number" aria-hidden="true"></span><span class="tab-label" data-i18n="pages.treatise.tabs.5">اقتصاد سهم‌ها</span></button>
      <button class="treatise-tab book-tab" data-target="postscript" type="button"><span class="tab-number" aria-hidden="true"></span><span class="tab-label" data-i18n="pages.treatise.tabs.6">پس‌گفتار</span></button>
    </nav>
    <article class="treatise-article" id="body" aria-label="رساله فلسفی نگرش نوین" data-i18n-aria="labels.treatise">
      <div class="treatise-mark" aria-hidden="true">S</div>
      <div class="treatise-content" id="treatise-content"></div>
    </article>
    <footer class="treatise-footer" aria-hidden="true">ساختار تالار · STRUCTURE OF THE HALL</footer>
  </div>
</main>
