{
  "schema": "page-completion/v1",
  "page": "emergence",
  "source": {
    "path": "content/emergence.js",
    "authority": "fa"
  },
  "translations": {
    "path": "translations/emergence.json",
    "languages": ["en", "ar", "zh"],
    "derived_from": "source"
  },
  "runtime": {
    "html": "emergence.html",
    "i18n": "translations/i18n.js"
  },
  "accessibility": {
    "required": true,
    "features": [
      "skip-link",
      "semantic-episode-navigation",
      "aria-current-active-item",
      "explicit-previous-next-labels",
      "visible-focus",
      "reduced-motion"
    ],
    "verification": [
      "keyboard-only",
      "screen-reader",
      "rtl-ltr",
      "mobile-portrait",
      "mobile-landscape",
      "desktop"
    ]
  }
}